FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV APPIMAGE_EXTRACT_AND_RUN=1

# Build the AppImage inside ubuntu:20.04 (glibc 2.31) with all system libs
# bundled, so it runs self-contained on fresh / minimal hosts (e.g. AppImageHub
# CI). The portable CPython (python-build-standalone) brings its own interpreter
# and pip, so we do NOT need python3 / python3-venv / python3-pip here.
#
# The xcb/xkb/X11/wayland/font packages provide the shared objects that get
# bundled via ldd so Qt's platform plugins load even on bare hosts.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        file \
        grep \
        tar \
        desktop-file-utils \
        squashfs-tools \
        clang \
        linux-libc-dev \
        libxcb1 \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-render0 \
        libxcb-shape0 \
        libxcb-shm0 \
        libxcb-sync1 \
        libxcb-util1 \
        libxcb-xfixes0 \
        libxcb-xinerama0 \
        libxcb-xkb1 \
        libxkbcommon-x11-0 \
        libxkbcommon0 \
        libwayland-client0 \
        libwayland-cursor0 \
        libwayland-egl1 \
        libfontconfig1 \
        libfreetype6 \
        libharfbuzz0b \
        libglib2.0-0 \
        libdbus-1-3 \
        libegl1 \
        libgl1 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

CMD ["./build_appimage.sh"]
